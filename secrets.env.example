# Copy to ~/.config/opencode/secrets.env and fill in your own values.
# Keep the file private: chmod 600 ~/.config/opencode/secrets.env

# API keys for MCP servers, referenced from opencode.json(c) as {env:NAME}
# CONTEXT7_API_KEY=
# GITHUB_TOKEN=

# Provider keys picked up by OpenCode from the environment
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
