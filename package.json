{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-secrets-env",
  "version": "0.5.0",
  "description": "OpenCode plugin that injects secrets from ~/.config/opencode/secrets.env into process.env at startup, hot-reloads them on change, and reconnects MCP servers so they pick up new values",
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "env.ts",
    "rawconfig.ts",
    "secrets.env.example"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "test:e2e": "node test/e2e/run.mjs --host v2 && node test/e2e/run.mjs --host v1",
    "test:e2e:v1": "node test/e2e/run.mjs --host v1",
    "test:e2e:v2": "node test/e2e/run.mjs --host v2",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "secrets",
    "env",
    "environment-variables",
    "dotenv",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytesnail/opencode-secrets-env.git"
  },
  "bugs": {
    "url": "https://github.com/bytesnail/opencode-secrets-env/issues"
  },
  "homepage": "https://github.com/bytesnail/opencode-secrets-env",
  "engines": {
    "node": ">=22.18",
    "opencode": ">=1.14.34"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.0",
    "dotenv": "^18.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
